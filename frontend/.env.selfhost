# =============================================================================
# Frontend Environment Variables - Self-Hosted Authentication Mode
# =============================================================================

# 认证模式配置（必填）
# clerk: 使用 Clerk 第三方认证（需要 NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY）
# selfhost: 使用自托管 JWT 认证（推荐用于私有部署）
NEXT_PUBLIC_AUTH_MODE=selfhost

# API 配置
# 后端 API 地址（根据部署环境修改）
NEXT_PUBLIC_API_URL=http://localhost:8004/api/v1

# Clerk 认证配置（仅在 AUTH_MODE=clerk 时需要）
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxx
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# 环境配置
NODE_ENV=development
# NEXT_PUBLIC_ENVIRONMENT=development
