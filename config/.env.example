# =============================================================================
# Data Agent V4 - Environment Configuration
# =============================================================================
# 复制此文件为 .env 并填入真实值
# Copy this file to .env and fill in real values

# =============================================================================
# Agent V2 Model Routing
# =============================================================================
# Agent V2 runtime model selection uses LLM_MODEL only.
# Examples: deepseek-chat, deepseek-reasoner, glm-4-flash, glm-5
LLM_MODEL=deepseek-chat

# =============================================================================
# DeepSeek API Configuration
# =============================================================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Legacy field kept for compatibility; Agent V2 does not use it for routing.
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# =============================================================================
# 智谱AI API配置 / ZhipuAI API Configuration
# =============================================================================
# 必须提供有效的智谱AI API密钥 (从 https://open.bigmodel.cn/ 获取)
# Must provide a valid ZhipuAI API key (get from https://open.bigmodel.cn/)
#
# ⚠️  安全提示:
#    - 不要将真实API密钥提交到版本控制系统
#    - 定期检查API密钥使用情况和配额
#    - 如果密钥泄露，立即在控制台重新生成
#
# 📋 支持的模型:
#    - glm-4-flash: 快速响应，适合实时对话 (推荐)
#    - glm-4: 标准模型，平衡性能与质量
#    - glm-4-long: 长上下文模型，支持大量文本
#
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
# Legacy field kept for compatibility; Agent V2 does not use it for routing.
ZHIPUAI_DEFAULT_MODEL=glm-4-flash
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPUAI_TIMEOUT=30
ZHIPUAI_MAX_RETRIES=3

# =============================================================================
# 数据库配置 / Database Configuration
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/dataagent
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/dataagent

# =============================================================================
# MinIO对象存储配置 / MinIO Object Storage Configuration
# =============================================================================
# ⚠️  安全要求:
#    - 必须使用强随机密钥，不要使用默认值 "minioadmin"
#    - MINIO_ACCESS_KEY: 至少32字符，包含字母和数字
#    - MINIO_SECRET_KEY: 至少64字符，包含字母、数字和特殊字符
#    - 生产环境必须定期轮换密钥（建议每90天）
#
# 💡 生成强密钥: python scripts/generate_keys.py
#
MINIO_ROOT_USER=your_strong_minio_root_user_min_32_chars
MINIO_ROOT_PASSWORD=your_strong_minio_root_password_min_64_chars
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_strong_minio_access_key_min_32_chars
MINIO_SECRET_KEY=your_strong_minio_secret_key_min_64_chars
MINIO_SECURE=false
MINIO_BUCKET_NAME=dataagent-files

# =============================================================================
# ChromaDB向量数据库配置 / ChromaDB Vector Database Configuration
# =============================================================================
CHROMA_HOST=localhost
CHROMA_PORT=8001

# =============================================================================
# 安全配置 / Security Configuration
# =============================================================================
# ⚠️  JWT密钥安全要求:
#    - SECRET_KEY: 至少64字符，包含大小写字母、数字和特殊字符
#    - 用于JWT令牌签名，泄露将导致严重安全问题
#    - 生产环境必须使用强随机密钥
#    - 定期轮换密钥（建议每90天）
#
# 💡 生成强密钥: python scripts/generate_keys.py --key-type secret
#
SECRET_KEY=your-super-secret-key-generate-a-strong-one-in-production-min-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# =============================================================================
# 应用配置 / Application Configuration
# =============================================================================
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# =============================================================================
# CORS配置 / CORS Configuration
# =============================================================================
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# =============================================================================
# 日志配置 / Logging Configuration
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Sentry监控配置 / Sentry Monitoring Configuration (可选)
# =============================================================================
# ⚠️  可选配置 - 用于生产环境错误追踪和性能监控
#    - 从 https://sentry.io 获取DSN
#    - 开发环境可以不配置
#    - 生产环境强烈建议配置
#
# 后端Sentry配置
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# 前端Sentry配置
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# Redis配置 (可选) / Redis Configuration (Optional)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# 缓存配置 / Cache Configuration
# =============================================================================
# 缓存类型: memory (内存缓存), redis (Redis分布式缓存)
CACHE_TYPE=memory
# Redis缓存配置 (仅当CACHE_TYPE=redis时生效)
CACHE_MAX_CONNECTIONS=10
# 内存缓存配置 (仅当CACHE_TYPE=memory时生效)
CACHE_MAX_SIZE=10000
CACHE_DEFAULT_TTL=3600

# =============================================================================
# 前端环境变量 / Frontend Environment Variables
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8004
NEXT_PUBLIC_MINIO_ENDPOINT=http://localhost:9000
NEXT_PUBLIC_MINIO_BUCKET=dataagent-files

# =============================================================================
# 开发工具配置 / Development Tools Configuration
# =============================================================================
# 启用热重载 / Enable hot reload
HOT_RELOAD=true

# 启用调试模式 / Enable debug mode
DEBUG_MODE=true

# 测试数据初始化 / Initialize test data
INIT_TEST_DATA=true
