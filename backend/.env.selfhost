# =============================================================================
# Backend Environment Variables - Self-Hosted Authentication Mode
# =============================================================================

# 应用配置
APP_NAME=Data Agent Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# 认证模式配置（必填）
# clerk: 使用 Clerk 第三方认证
# selfhost: 使用自托管 JWT 认证
AUTH_MODE=selfhost

# 数据库配置（必填）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dataagent

# JWT 密钥（自托管模式必填，用于签名 JWT token）
# 生成方法：openssl rand -base64 32
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# MinIO 对象存储配置
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# 智谱 AI 配置
ZHIPUAI_API_KEY=your-zhipuai-api-key-here

# DeepSeek 配置（可选，作为备用）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter 配置（可选）
# OPENROUTER_API_KEY=your-openrouter-key-here

# API 前缀
API_V1_PREFIX=/api/v1

# 密钥轮换配置
KEY_ROTATION_ENABLED=true
KEY_ROTATION_REMINDER_DAYS=7
KEY_ROTATION_INTERVAL_DAYS=90

# Sentry 监控（可选）
# SENTRY_DSN=your-sentry-dsn-here
# SENTRY_ENVIRONMENT=development
